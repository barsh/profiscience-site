<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS redirects + static hosting for the new Profiscience site.
  Requires the IIS "URL Rewrite" module on the VM (https://www.iis.net/downloads/microsoft/url-rewrite).
  All redirects are 301 (permanent) so search engines transfer ranking to the new URLs.
  Fragments (#clesite etc.) can't be read server-side, so anchor-specific old links
  land on the right page but not the exact section — acceptable.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <!-- Products -> Features -->
        <rule name="old-products" stopProcessing="true">
          <match url="^products\.aspx$" />
          <action type="Redirect" url="/features.html" redirectType="Permanent" />
        </rule>

        <!-- About -->
        <rule name="old-about" stopProcessing="true">
          <match url="^about\.aspx$" />
          <action type="Redirect" url="/about.html" redirectType="Permanent" />
        </rule>

        <!-- Contact + old demo request -->
        <rule name="old-contact" stopProcessing="true">
          <match url="^(contact|request-demo)\.aspx$" />
          <action type="Redirect" url="/contact.html" redirectType="Permanent" />
        </rule>

        <!-- Testimonials -->
        <rule name="old-testimonials" stopProcessing="true">
          <match url="^testimonials\.aspx$" />
          <action type="Redirect" url="/clients.html#testimonials" redirectType="Permanent" />
        </rule>

        <!-- Support (was extensionless) -->
        <rule name="old-support" stopProcessing="true">
          <match url="^support/?$" />
          <action type="Redirect" url="/support.html" redirectType="Permanent" />
        </rule>

        <!-- Stay CLEver book: chapters, CLE Corner, then the landing page -->
        <rule name="old-book-chapters" stopProcessing="true">
          <match url="^stay-clever-book/chapter[0-9]+\.aspx$" />
          <action type="Redirect" url="/stay-clever.html" redirectType="Permanent" />
        </rule>
        <rule name="old-book-cle-corner" stopProcessing="true">
          <match url="^stay-clever-book/cle-corner/?$" />
          <action type="Redirect" url="/stay-clever.html#free-copy" redirectType="Permanent" />
        </rule>
        <rule name="old-book" stopProcessing="true">
          <match url="^stay-clever-book/?$" />
          <action type="Redirect" url="/stay-clever.html" redirectType="Permanent" />
        </rule>

        <!-- Newsletter opt-in / opt-out -->
        <rule name="old-opt-in" stopProcessing="true">
          <match url="^opt-in\.aspx$" />
          <action type="Redirect" url="/stay-clever.html#free-copy" redirectType="Permanent" />
        </rule>
        <rule name="old-opt-out" stopProcessing="true">
          <match url="^opt-out\.aspx$" />
          <action type="Redirect" url="/unsubscribe.html" redirectType="Permanent" />
        </rule>

        <!-- Old case-study PDFs -> new case-study pages.
             Matched by first word so the spaces/commas in the old filenames don't matter.
             Order matters: specific firms first, then the catch-all. -->
        <rule name="cs-bond" stopProcessing="true">
          <match url="^CaseStudies/Bond.*\.pdf$" />
          <action type="Redirect" url="/case-study-bond-schoeneck-king.html" redirectType="Permanent" />
        </rule>
        <rule name="cs-foley" stopProcessing="true">
          <match url="^CaseStudies/Foley.*\.pdf$" />
          <action type="Redirect" url="/case-study-foley-lardner.html" redirectType="Permanent" />
        </rule>
        <rule name="cs-haynes" stopProcessing="true">
          <match url="^CaseStudies/Haynes.*\.pdf$" />
          <action type="Redirect" url="/case-study-haynes-boone.html" redirectType="Permanent" />
        </rule>
        <rule name="cs-steptoe" stopProcessing="true">
          <match url="^CaseStudies/Steptoe.*\.pdf$" />
          <action type="Redirect" url="/case-study-steptoe-johnson.html" redirectType="Permanent" />
        </rule>
        <rule name="cs-verrill" stopProcessing="true">
          <match url="^CaseStudies/Verrill.*\.pdf$" />
          <action type="Redirect" url="/case-study-verrill.html" redirectType="Permanent" />
        </rule>
        <rule name="cs-wbd" stopProcessing="true">
          <match url="^CaseStudies/WBD.*\.pdf$" />
          <action type="Redirect" url="/case-study-womble-bond-dickinson.html" redirectType="Permanent" />
        </rule>
        <!-- ScormFly / "UniversitySite Return to US" have no dedicated page -> case-study hub -->
        <rule name="cs-other" stopProcessing="true">
          <match url="^CaseStudies/.*\.pdf$" />
          <action type="Redirect" url="/clients.html" redirectType="Permanent" />
        </rule>

        <!-- NOTE: members/login.aspx intentionally NOT redirected (no login on the new site). -->
        <!-- TODO: decide handling for /UniversitySite-Public-API-Documentation. -->
      </rules>
    </rewrite>

    <!-- Serve pretty defaults -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <!-- Ensure modern types are served (webp used by some logos) -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

  </system.webServer>
</configuration>
